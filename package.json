{
  "name": "react-pwa-promotion",
  "homepage": "https://js.work",
  "version": "1.0.0",
  "description": "A tiny React update prompt for Vite PWA (vite-plugin-pwa).",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {},
  "scripts": {
    "dev": "pnpm --filter example dev",
    "predocs": "rm -rf docs",
    "docs": "pnpm --filter example build",
    "postdocs": "cp -R packages/example/dist docs",
    "ln:build": "pnpm --filter @jswork/react-pwa-promotion build",
    "ln:publish": "pnpm --filter @jswork/react-pwa-promotion release"
  }
}
